FROM node:25-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:mcp

FROM node:25-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001

COPY --from=build --chown=node:node /app/dist-mcp ./dist-mcp

USER node
EXPOSE 3001
CMD ["node", "dist-mcp/server.mjs"]
